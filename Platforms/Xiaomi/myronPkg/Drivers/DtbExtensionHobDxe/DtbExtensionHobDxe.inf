## @file
#  Publish the device tree ABL handed over as the DtbExtension HOB.
#
#  Mu's PlatformPeiLib derives that address by scanning the "FD Reserved" region
#  for the stock UEFI's HOB registration function, which only exists when the
#  stock firmware is the one running. A "fastboot boot" payload has to supply it
#  itself; see DtbExtensionHobDxe.c. It is a DXE driver rather than a PEIM
#  because this platform maps HobLib onto the DXE instance only.
#
#  Copyright (c) 2026, myron port.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = DtbExtensionHobDxe
  FILE_GUID                      = 6B1F4C52-8E57-4C1D-9E3A-2F0B7A5D94C1
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = DtbExtensionHobEntry

[Sources]
  DtbExtensionHobDxe.c

[Packages]
  MdePkg/MdePkg.dec
  QcomPkg/QcomPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  HobLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiFirmwareVolume2ProtocolGuid

[Guids]
  gEfiDtbExtensionHobGuid

#
# TRUE on purpose. This driver is in APRIORI ahead of the vendor stack, and the
# volume protocol it reads the tree from is published by DxeCore itself while
# the APRIORI list runs, so waiting on it here would deadlock this driver
# against the very ordering that makes it useful. The entry point retries the
# lookup instead.
#
[Depex]
  TRUE
